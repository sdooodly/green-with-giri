generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  latinName   String
  description String?
  priceInPaise Int     // Store in paise for precision (₹48 = 4800)
  imageUrl    String?
  badges      String[] // ["beginner", "pet-safe", "rare", "low-light"]
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id                String      @id @default(cuid())
  userId            String?
  status            OrderStatus @default(PENDING)
  totalInPaise      Int
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  razorpaySignature String?
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  priceInPaise Int
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}
